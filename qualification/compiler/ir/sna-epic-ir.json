        "boundary_type": "scope_forbidden"
      },
      {
        "constraint_id": "AUTH-4",
        "statement": "Bypass paths for any production workflow are forbidden",
        "boundary_type": "scope_forbidden"
      }
    ],

    "lifecycle_rules": [
      { "rule_id": "LR-1", "from_state": "UNRESERVED", "to_state": "RESERVED", "condition": "atomic_reserve(number, sprint_id)", "is_legal": true },
      { "rule_id": "LR-2", "from_state": "RESERVED", "to_state": "BOUND", "condition": "bind(number, sprint_id, project_id)", "is_legal": true },
      { "rule_id": "LR-3", "from_state": "BOUND", "to_state": "BUILDING", "condition": "can_build(sprint_id, number)", "is_legal": true },
      { "rule_id": "LR-4", "from_state": "BOUND", "to_state": "COMMITTED", "condition": "commit(number, sprint_id)", "is_legal": true },
      { "rule_id": "LR-5", "from_state": "COMMITTED", "to_state": "SEALED", "condition": "validate_seal(number, sprint_id, project_id)", "is_legal": true },
      { "rule_id": "LR-6", "from_state": "RESERVED", "to_state": "RELEASED", "condition": "release(number, reason)", "is_legal": true },
      { "rule_id": "LR-7", "from_state": "UNRESERVED", "to_state": "BUILDING", "condition": "build_without_reservation", "is_legal": false },
      { "rule_id": "LR-8", "from_state": "RESERVED", "to_state": "BOUND", "condition": "bind_to_wrong_sprint", "is_legal": false },
      { "rule_id": "LR-9", "from_state": "UNRESERVED", "to_state": "SEALED", "condition": "seal_without_reservation", "is_legal": false },
      { "rule_id": "LR-10", "from_state": "RELEASED", "to_state": "SEALED", "condition": "seal_with_released_reservation", "is_legal": false },
      { "rule_id": "LR-11", "from_state": "RESERVED", "to_state": "RESERVED", "condition": "duplicate_reservation", "is_legal": false }
    ],

    "stop_conditions": [
      { "condition_id": "STOP-1", "predicate": "any_production_path_unprotected_after_sna_6", "severity": "hard_stop", "message": "Production path remains unprotected" },
