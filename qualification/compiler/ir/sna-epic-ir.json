  "contract_source": {
    "governing_invariant": {
      "statement": "A sprint cannot become buildable, active, or sealed unless its sprint number has been atomically reserved for that specific sprint through the authoritative allocation mechanism. No production path may assign a sprint number through an alternate mechanism.",
      "testable_form": "∀ workflow ∈ supported_workflows: creates_sprint(w, s) ∧ buildable(s) → ∃ reservation r: r.number = s.number ∧ r.sprint_id = s.id ∧ r.status ∈ {BOUND, COMMITTED}",
      "negation": "∃ sprint s: buildable(s) ∧ ¬∃ reservation r with r.number = s.number ∧ r.sprint_id = s.id"
    },

    "invariants": [
      {
        "invariant_id": "INV-1",
        "statement": "A sprint number must be atomically reserved before a sprint becomes buildable",
        "testable_form": "buildable(s) → reserved(s.number, s.id)",
        "violation_shape": "Sprint enters BUILDING state without a reservation record",
        "defense_layers": ["application", "persistence"]
      },
      {
        "invariant_id": "INV-2",
        "statement": "No production path may assign a sprint number through an alternate mechanism",
        "testable_form": "∀ path ∈ production_paths: assigns_number(p, s, n) → p.uses(allocator)",
        "violation_shape": "Direct assignment of sealed_number without going through SprintNumberAllocator",
        "defense_layers": ["application"]
      },
      {
        "invariant_id": "INV-3",
        "statement": "Reservation must bind to specific sprint identity",
        "testable_form": "bound(r, s) → r.sprint_id = s.id ∧ r.project_id = s.project_id",
        "violation_shape": "Reservation bound to wrong sprint ID or detached from sprint",
        "defense_layers": ["application", "persistence"]
      },
      {
        "invariant_id": "INV-4",
        "statement": "Seal requires valid reservation, commit binding, and evidence gates",
        "testable_form": "sealed(s) → valid_reservation(s) ∧ commit_binding(s) ∧ evidence_gates(s)",
        "violation_shape": "Sprint sealed without all three prerequisites",
        "defense_layers": ["application", "persistence"]
      },
      {
        "invariant_id": "INV-5",
        "statement": "Persistence layer enforces uniqueness independently of application routing",
        "testable_form": "committed_store.unique_numbers ∧ seal_gate.validates_against_store",
        "violation_shape": "Duplicate committed numbers in the store or seal gate skipping validation",
        "defense_layers": ["persistence"]
      },
      {
        "invariant_id": "INV-6",
        "statement": "Import/restore distinguishes historical preservation from new allocation",
        "testable_form": "import(i) → (historical_restore(i) → preserves_number(i)) ∧ (clone_as_new(i) → requires_new_reservation(i))",
        "violation_shape": "Clone-as-new reuses source number or historical restore triggers unnecessary allocation",
        "defense_layers": ["application"]
      }
    ],

    "acceptance_gates": [
      {
        "gate_id": "GATE-A",
        "statement": "Every supported production creation path uses UWO-008",
        "testable_form": "∀ p ∈ production_creation_paths: p.calls(sprint_number_allocator)",
        "evidence_sources": ["sna-9-surface-audit", "code-path-traversal"]
      },
      {
        "gate_id": "GATE-B",
        "statement": "Contention produces exactly one winner",
        "testable_form": "∀ n ∈ contested_numbers: |{p : p.succeeds(n)}| = 1",
        "evidence_sources": ["concurrency-test-results", "barrier-synchronized-race"]
      },
      {
        "gate_id": "GATE-C",
        "statement": "Reservation precedes build and survives through seal",
        "testable_form": "∀ s ∈ sprints: buildable(s) → reserved_before_build(s) ∧ reservation_survives_through_seal(s)",
        "evidence_sources": ["workflow-test-results", "lifecycle-trace"]
      },
      {
        "gate_id": "GATE-D",
        "statement": "Bypass attempts are mechanically rejected at both application and persistence layers",
        "testable_form": "∀ a ∈ bypass_attempts: rejected(a, application) ∧ rejected(a, persistence)",
        "evidence_sources": ["negative-test-results", "adversarial-test-results"]
      },
      {
        "gate_id": "GATE-E",
        "statement": "The system mechanically prevents producing a live sprint whose number was not atomically reserved and bound to that sprint",
        "testable_form": "∀ s ∈ live_sprints: ∃ r: r.number = s.number ∧ r.sprint_id = s.id ∧ r.status ∈ {BOUND, COMMITTED}",
        "evidence_sources": ["critical-adversarial-results", "full-invariant-check"]
      }
    ],

    "authority_constraints": [
      {
        "constraint_id": "AUTH-1",
        "statement": "QA-Pilot operates advisory-only — no Librarian state mutation",
        "boundary_type": "mutation_forbidden"
      },
      {
        "constraint_id": "AUTH-2",
