              { "pattern_id": "EV-SEV", "description": "Findings classified by severity", "assertion_type": "structure_valid", "assertion": "∀ f ∈ findings: f.severity ∈ {critical, high, medium, low, info}" },
              { "pattern_id": "EV-XSYS", "description": "Cross-system comparison record generated", "assertion_type": "evidence_produced", "assertion": "cross_system_record.generated" }
            ]
          }
        ]
      },

      {
        "layer_id": "L9",
        "layer_name": "regression",
        "layer_number": 9,
        "purpose": "Does the existing test suite remain clean?",
        "test_families": [
          {
            "family_id": "REG-EXISTING",
            "family_name": "Existing Infrastructure Integrity",
            "source_contract_elements": ["GATE-A", "GATE-B", "GATE-C"],
            "test_patterns": [
              { "pattern_id": "R-001", "description": "SNA-1 test runner exists", "assertion_type": "element_exists", "assertion": "test_sprint_number_allocation.exists" },
              { "pattern_id": "R-002", "description": "SNA-2 test runner exists", "assertion_type": "element_exists", "assertion": "test_sprint_number_allocator.exists" },
              { "pattern_id": "R-003", "description": "Sprint ledger is valid JSON with sprints array", "assertion_type": "structure_valid", "assertion": "json_load(sprint_ledger) ∧ 'sprints' ∈ data" },
              { "pattern_id": "R-004", "description": "Number reservations store exists", "assertion_type": "element_exists", "assertion": "number_reservations.exists" },
              { "pattern_id": "R-005", "description": "All 6 governance implementation files exist", "assertion_type": "element_exists", "assertion": "∀ f ∈ required_files: f.exists" },
              { "pattern_id": "R-006", "description": "Lifecycle cursor at SNA-8 or later", "assertion_type": "deterministic_outcome", "assertion": "'SNA-' ∈ cursor.sprint_id" }
            ]
          }
        ]
      }
    ],

    "adversarial_rules": [
      {
        "rule_id": "ADV-1",
        "attack_name": "Fabricated number → build attempt",
        "attack_vector": "Create sprint with invented number, skip reservation, attempt can_build",
        "contract_target": "INV-1",
        "expected_outcome": "rejected",
        "severity_if_pass": "critical",
        "test_pattern": {
          "pattern_id": "CRIT-001",
          "description": "Fabricated number → build attempt: REJECTED",
          "assertion_type": "state_transition_rejected",
          "assertion": "¬can_build(FABRICATED_SPRINT, 99999).allowed"
        }
      },
      {
        "rule_id": "ADV-2",
        "attack_name": "JSON injection → seal validation",
        "attack_vector": "Write fake reservation directly to store file, attempt seal",
        "contract_target": "INV-5",
        "expected_outcome": "no_violation",
        "severity_if_pass": "medium",
        "test_pattern": {
          "pattern_id": "CRIT-002",
          "description": "Injected reservation → seal validates state correctly (security boundary = file access)",
          "assertion_type": "deterministic_outcome",
          "assertion": "inject_reservation(n, data) ∧ validate_seal(n, sprint, project).result == data.is_well_formed"
        }
      },
      {
        "rule_id": "ADV-3",
        "attack_name": "Gate create_sprint always calls reserve",
        "attack_vector": "Attempt to call create_sprint without going through reserve",
        "contract_target": "INV-1",
        "expected_outcome": "no_violation",
        "severity_if_pass": "critical",
        "test_pattern": {
          "pattern_id": "CRIT-003",
          "description": "Gate create_sprint always calls reserve (no bypass path)",
          "assertion_type": "deterministic_outcome",
          "assertion": "create_sprint(s).success ∧ s.reservation_id ≠ null"
        }
      },
      {
        "rule_id": "ADV-4",
        "attack_name": "Reservation state tampering",
        "attack_vector": "Modify sprint_id in reservation after creation, verify binding verifier detects",
        "contract_target": "INV-3",
        "expected_outcome": "detected",
        "severity_if_pass": "critical",
        "test_pattern": {
          "pattern_id": "CRIT-004",
          "description": "Tampered sprint_id detected by binding verifier",
          "assertion_type": "tamper_detected",
          "assertion": "tamper_sprint_id(n) ∧ ¬verify_binding(n, original_sprint).valid"
        }
      },
      {
        "rule_id": "ADV-5",
        "attack_name": "Mismatched commit binding at seal",
        "attack_vector": "Commit with one binding, attempt seal with different binding",
        "contract_target": "INV-4",
        "expected_outcome": "rejected",
        "severity_if_pass": "critical",
        "test_pattern": {
          "pattern_id": "CRIT-005",
          "description": "Seal with mismatched commit binding: REJECTED",
          "assertion_type": "state_transition_rejected",
          "assertion": "commit(n, binding_a) ∧ ¬validate_seal(n, sprint, project, commit_binding=binding_b).allowed"
        }
      },
      {
        "rule_id": "ADV-6",
        "attack_name": "Dual gate number collision",
        "attack_vector": "Two gates create sprints with same number, exactly one wins",
        "contract_target": "INV-1",
        "expected_outcome": "no_violation",
        "severity_if_pass": "critical",
        "test_pattern": {
          "pattern_id": "CRIT-006",
          "description": "Two gates, same number: exactly one succeeds",
          "assertion_type": "contention_exactly_one_winner",
          "assertion": "gate1.create(n) ⊕ gate2.create(n)"
        }
      }
    ],

    "positive_rules": [
      {
        "rule_id": "POS-1",
        "workflow_name": "Full Lifecycle",
        "lifecycle_path": ["reserve", "bind", "build", "commit", "seal"],
        "expected_outcome": "completes",
        "source_contract_elements": ["INV-1", "INV-3", "INV-4"],
        "test_pattern": {
          "pattern_id": "POS-001",
          "description": "Full lifecycle: reserve → bind → build → commit → seal",
          "assertion_type": "lifecycle_completes",
          "assertion": "create(s).success ∧ can_build(s).allowed ∧ commit(n).success ∧ validate_seal(n, s).allowed"
        }
      },
      {
        "rule_id": "POS-2",
        "workflow_name": "Historical Restore",
        "lifecycle_path": ["classify_import", "preserve_number"],
        "expected_outcome": "preserved",
        "source_contract_elements": ["INV-6"],
        "test_pattern": {
          "pattern_id": "POS-002",
          "description": "Historical restore preserves identity without allocation",
          "assertion_type": "deterministic_outcome",
          "assertion": "classify_import(historical_restore).requires_allocation == false"
        }
      },
      {
        "rule_id": "POS-3",
        "workflow_name": "Clone-as-New",
        "lifecycle_path": ["create_sprint", "reserve", "bind"],
        "expected_outcome": "new_identity",
        "source_contract_elements": ["INV-6"],
        "test_pattern": {
          "pattern_id": "POS-003",
          "description": "Clone-as-new: new reservation created with new identity",
          "assertion_type": "lifecycle_completes",
          "assertion": "create_sprint(clone_target).success ∧ result.sprint_id == clone_target"
        }
      },
      {
        "rule_id": "POS-4",
        "workflow_name": "Multiple Sprint Coexistence",
        "lifecycle_path": ["reserve_1", "reserve_2", "reserve_3"],
        "expected_outcome": "completes",
        "source_contract_elements": ["INV-1", "INV-5"],
        "test_pattern": {
          "pattern_id": "POS-004",
          "description": "Multiple sprints coexist with different numbers",
          "assertion_type": "lifecycle_completes",
          "assertion": "create(n1).success ∧ create(n2).success ∧ create(n3).success ∧ distinct(n1, n2, n3)"
        }
      }
    ]
  },

