    "scope": {
      "allowed": [
        "Contract and state model for reservation lifecycle",
        "Authoritative allocation boundary (SprintNumberAllocator service)",
        "Sprint creation gate (reserve before build)",
        "Reservation-to-sprint binding",
        "Seal gate enforcement",
        "Elimination of alternate allocation paths (47 direct-assignment sites)",
