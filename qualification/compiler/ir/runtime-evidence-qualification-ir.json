{
  "ir_metadata": {
    "ir_id": "IR-RUNTIME-EVIDENCE-QUALIFICATION-1",
    "ir_version": "1.0.0",
    "created_at": "2026-08-16T04:00:00Z",
    "contract_ref": "runtime-evidence-ingestion-contract",
    "compiler_version": "1.0.0",
    "source_hash": "sha256:runtime-evidence-qualification-v1",
    "tags": ["runtime-evidence", "qualification", "trust-calibration", "sprint-222"]
  },
  "contract_source": {
    "governing_invariant": {
      "statement": "Every runtime evidence record must be provably complete, immutable, fresh, and authority-bounded to serve as a qualification input.",
      "testable_form": "forall(e in RuntimeEvidence): complete(e.provenance) AND immutable(e) AND fresh(e) AND bounded(e.authority)",
      "negation": "exists(e in RuntimeEvidence): NOT complete(e.provenance) OR NOT immutable(e) OR NOT fresh(e) OR NOT bounded(e.authority)"
    },
    "invariants": [
      {
        "invariant_id": "INV-1",
        "statement": "Every runtime evidence record has complete provenance covering all 6 identity questions.",
        "testable_form": "forall(e): has_field(e, 'provenance.execution_identity.node_identity') AND has_field(e, 'provenance.execution_identity.runtime_identity') AND has_field(e, 'provenance.execution_identity.agent_identity') AND has_field(e, 'provenance.execution_identity.model_identity') AND has_field(e, 'provenance.execution_identity.session_identity') AND has_field(e, 'provenance.governance_context.authority_scope')",
        "violation_shape": "Missing provenance field(s) in runtime evidence record",
        "defense_layers": ["application", "persistence"]
      },
      {
        "invariant_id": "INV-2",
        "statement": "Runtime evidence records are immutable after ingestion.",
        "testable_form": "forall(e): immutable_after(e, e.ingested_at)",
        "violation_shape": "Modified timestamp, content, or provenance after ingestion",
        "defense_layers": ["persistence"]
      },
      {
        "invariant_id": "INV-3",
        "statement": "Runtime evidence records age correctly based on their evidence class.",
        "testable_form": "forall(e): (e.evidence_class == 'record' => label(e) in {current, historical, archived}) AND (e.evidence_class == 'snapshot' => label(e) in {current, stale, unknown})",
        "violation_shape": "Incorrect freshness label assignment",
        "defense_layers": ["application"]
      },
      {
        "invariant_id": "INV-4",
        "statement": "Runtime evidence records do not contain authority-claiming fields.",
        "testable_form": "forall(e): NOT has_field(e, 'authorization') AND NOT has_field(e, 'dispatch') AND NOT has_field(e, 'executed') AND NOT has_field(e, 'sealed') AND NOT has_field(e, 'approved') AND NOT has_field(e, 'owner_decision')",
        "violation_shape": "Authority field present in evidence record",
        "defense_layers": ["application", "persistence"]
      },
      {
        "invariant_id": "INV-5",
        "statement": "Every runtime evidence record conforms to its source schema.",
        "testable_form": "forall(e): schema_valid(e, source_schema(e.event_type))",
        "violation_shape": "Schema validation failure",
        "defense_layers": ["application"]
      }
    ],
    "acceptance_gates": [
      {
        "gate_id": "GATE-A",
        "statement": "All 5 qualification checks pass against all ingested runtime evidence records.",
        "testable_form": "forall(e in IngestedEvidence): forall(check in QualificationChecks): check(e) == PASS",
        "evidence_sources": ["qualification-results.json"]
      },
      {
        "gate_id": "GATE-B",
        "statement": "Qualification engine produces deterministic results (same input → same output).",
        "testable_form": "run(qualification_engine, evidence) == run(qualification_engine, evidence)",
        "evidence_sources": ["qualification-results.json"]
      },
      {
        "gate_id": "GATE-C",
        "statement": "Qualification engine does not elevate evidence to authority.",
        "testable_form": "forall(result in QualificationResults): NOT has_field(result, 'authorization') AND NOT has_field(result, 'dispatch')",
        "evidence_sources": ["qualification-results.json"]
      }
    ],
    "authority_constraints": [
      {
        "constraint_id": "AC-1",
        "statement": "Qualification engine produces PASS/FINDING/NOT_APPLICABLE dispositions only.",
        "boundary_type": "scope_forbidden"
      },
      {
        "constraint_id": "AC-2",
        "statement": "Qualification engine MUST NOT produce authorization, dispatch, or execution directives.",
        "boundary_type": "mutation_forbidden"
      }
    ],
    "lifecycle_rules": [
      {
        "rule_id": "LR-1",
        "from_state": "unqualified",
        "to_state": "qualified",
        "condition": "all_checks_pass(evidence)",
        "is_legal": true
      },
      {
        "rule_id": "LR-2",
        "from_state": "unqualified",
        "to_state": "finding",
        "condition": "any_check_fails(evidence)",
        "is_legal": true
      },
      {
        "rule_id": "LR-3",
        "from_state": "qualified",
        "to_state": "authorized",
        "condition": "false",
        "is_legal": false
      }
    ],
    "stop_conditions": [
      {
        "condition_id": "STOP-1",
        "predicate": "evidence_store_empty()",
        "severity": "hard_stop",
        "message": "No runtime evidence records to qualify"
      },
      {
        "condition_id": "STOP-2",
        "predicate": "schema_invalid(ir_file)",
        "severity": "hard_stop",
        "message": "IR file does not conform to qualification-ir.schema.json"
      }
    ],
    "evidence_requirements": [
      {
        "requirement_id": "ER-1",
        "claim": "Runtime evidence records exist and are accessible",
        "evidence_class": "record",
        "method": "file_exists(data/runtime-evidence/index.json)",
        "freshness": "immutable"
      },
      {
        "requirement_id": "ER-2",
        "claim": "Qualification results are deterministic",
        "evidence_class": "record",
        "method": "run_twice_same_output()",
        "freshness": "immutable"
      }
    ],
    "scope": {
      "allowed": ["runtime-action-event", "runtime-lifecycle-event", "runtime-resource-observation"],
      "forbidden": ["cross-project-evidence", "non-qa-pilot-evidence"]
    }
  },
