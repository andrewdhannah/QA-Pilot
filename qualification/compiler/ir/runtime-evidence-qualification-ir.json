    "adversarial_rules": [
      {
        "rule_id": "ADV-1",
        "attack_name": "Authority Elevation via Qualification",
        "attack_vector": "Inject authority-claiming fields into qualification output",
        "contract_target": "INV-4",
        "expected_outcome": "rejected",
        "severity_if_pass": "critical",
        "test_pattern": {
          "pattern_id": "CRIT-001",
          "description": "Qualification engine rejects evidence with authorization field",
          "assertion_type": "state_transition_rejected",
          "assertion": "qualify(evidence_with_authorization) == {disposition: 'FINDING', reason: 'authority_boundary_violation'}"
        }
      },
