<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <title>Dynamics CRM — Case Investigation</title>
        <style>
            body {
                margin: 0;
                font-family:
                    system-ui,
                    -apple-system,
                    "Segoe UI",
                    sans-serif;
                padding: 12px;
                font-size: 13px;
                background: #f5f5f5;
            }
            h3 {
                margin-top: 0;
                margin-bottom: 6px;
            }
            p {
                margin-top: 0;
                margin-bottom: 8px;
            }
            .panel {
                background: #fff;
                border: 1px solid #ddd;
                padding: 12px;
                border-radius: 4px;
                max-width: 640px;
            }
            .panel-header {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 8px;
            }
            .panel-header small {
                color: #666;
                font-size: 11px;
            }
            .field-row {
                display: flex;
                gap: 12px;
                margin-bottom: 8px;
            }
            .field {
                flex: 1;
                margin-bottom: 8px;
            }
            .field label {
                display: block;
                font-size: 11px;
                color: #555;
                margin-bottom: 2px;
            }
            .field input,
            .field select,
            .field textarea {
                width: 100%;
                font-size: 12px;
                padding: 4px;
                box-sizing: border-box;
            }
            .field textarea {
                resize: vertical;
            }
            .toolbar {
                margin-bottom: 8px;
                display: flex;
                gap: 8px;
                align-items: center;
            }
            button {
                font-size: 12px;
                padding: 4px 10px;
                cursor: pointer;
            }
            .btn-primary {
                background: #0078d4;
                color: #fff;
                border: 1px solid #005a9e;
            }
            .btn-secondary {
                background: #e1e1e1;
                border: 1px solid #c2c2c2;
            }
            .status-pill {
                display: inline-block;
                padding: 2px 8px;
                border-radius: 999px;
                font-size: 11px;
                background: #e1f3ff;
                color: #005a9e;
            }
            .error {
                color: #b00020;
                font-size: 11px;
                margin-bottom: 6px;
            }
            .hint {
                font-size: 11px;
                color: #666;
                margin-top: 4px;
            }
            .readonly {
                background: #f3f3f3;
            }
        </style>
    </head>
    <body>
        <div id="dyn-root"></div>

        <script>
            (function () {
                const OS = window.parent.OS || window.parent.QA_OS;

                const appState = {
                    boot: null,
                    role: "junior",
                    scenarioId: "case-001",
                    caseData: null,
                    linkedBug: null,
                    draft: {
                        title: "",
                        priority: "",
                        status: "",
                        summary: "",
                        resolution: "",
                    },
                };

                // restore persisted state if present
                if (OS && OS.loadAppState) {
                    const saved = OS.loadAppState("dynamics");
                    if (saved) Object.assign(appState, saved);
                }

                window.addEventListener("message", (event) => {
                    const msg = event.data;
                    if (!msg || msg.type !== "APP_BOOT") return;
                    if (msg.appId !== "dynamics") return;

                    appState.boot = msg;
                    appState.role = msg.role || appState.role;

                    loadScenario(appState.scenarioId);
                    render();
                });

                function persist() {
                    if (OS && OS.saveAppState) {
                        OS.saveAppState("dynamics", appState);
                    }
                }

                function loadScenario(id) {
                    if (!OS || !OS.loadScenario) return;
                    const s = OS.loadScenario(id);
                    if (!s) return;

                    appState.scenarioId = id;
                    appState.caseData = s;

                    if (s.linkedBug) {
                        appState.linkedBug =
                            OS.loadScenario(s.linkedBug) || null;
                    } else {
                        appState.linkedBug = null;
                    }

                    // initialise draft from scenario if empty
                    if (!appState.draft.title) {
                        appState.draft.title = s.title || "";
                    }
                    if (!appState.draft.priority) {
                        appState.draft.priority = s.priority || "Medium";
                    }
                    if (!appState.draft.status) {
                        appState.draft.status = s.status || "Active";
                    }
                    if (!appState.draft.summary) {
                        appState.draft.summary = s.summary || "";
                    }
                    persist();
                }

                function render() {
                    const root = document.getElementById("dyn-root");
                    if (!root) return;

                    const roleLabel =
                        appState.role === "senior"
                            ? "Senior Investigator"
                            : "Junior Investigator";

                    const caseTitle = appState.draft.title || "(Untitled case)";
                    const status = appState.draft.status || "Active";
                    const priority = appState.draft.priority || "Medium";

                    const linkedBugId =
                        appState.linkedBug && appState.linkedBug.id
                            ? appState.linkedBug.id
                            : appState.caseData && appState.caseData.linkedBug
                              ? appState.caseData.linkedBug
                              : "None";

                    root.innerHTML = `
            <div class="panel">
              <div class="panel-header">
                <div>
                  <h3 style="margin-bottom:2px;">Dynamics Case</h3>
                  <small>Scenario: ${appState.scenarioId}</small>
                </div>
                <small>${roleLabel}</small>
              </div>

              <div class="toolbar">
                <button id="dyn-save-btn" class="btn-primary">Save</button>
                <button id="dyn-escalate-btn" class="btn-secondary">Escalate</button>
                <button id="dyn-resolve-btn" class="btn-secondary">Resolve</button>
                <span class="status-pill">Status: ${status}</span>
              </div>

              <div id="dyn-error" class="error" style="display:none;"></div>

              <div class="field-row">
                <div class="field">
                  <label>Case ID</label>
                  <input value="${appState.caseData ? appState.caseData.id : ""}" class="readonly" readonly />
                </div>
                <div class="field">
                  <label>Priority</label>
                  <select id="dyn-priority">
                    <option value="Low" ${priority === "Low" ? "selected" : ""}>Low</option>
                    <option value="Medium" ${priority === "Medium" ? "selected" : ""}>Medium</option>
                    <option value="High" ${priority === "High" ? "selected" : ""}>High</option>
                  </select>
                </div>
                <div class="field">
                  <label>Linked Bug</label>
                  <input id="dyn-linked-bug" value="${linkedBugId}" class="readonly" readonly />
                </div>
              </div>

              <div class="field">
                <label>Title</label>
                <input id="dyn-title" value="${escapeHtml(caseTitle)}" />
              </div>

              <div class="field">
                <label>Summary</label>
                <textarea id="dyn-summary" rows="4">${escapeHtml(
                    appState.draft.summary || "",
                )}</textarea>
              </div>

              <div class="field">
                <label>Resolution ${
                    appState.role === "junior"
                        ? "(Senior only — read-only for Junior)"
                        : ""
                }</label>
                <textarea id="dyn-resolution" rows="3" ${
                    appState.role === "junior"
                        ? "readonly class='readonly'"
                        : ""
                }>${escapeHtml(appState.draft.resolution || "")}</textarea>
              </div>

              <div class="hint">
                Junior cannot resolve cases or edit resolution notes. Use Escalate to hand off to a Senior.
              </div>
            </div>
          `;

                    wireHandlers();
                }

                function wireHandlers() {
                    const titleEl = document.getElementById("dyn-title");
                    const priorityEl = document.getElementById("dyn-priority");
                    const summaryEl = document.getElementById("dyn-summary");
                    const resolutionEl =
                        document.getElementById("dyn-resolution");
                    const errorEl = document.getElementById("dyn-error");

                    const saveBtn = document.getElementById("dyn-save-btn");
                    const escalateBtn =
                        document.getElementById("dyn-escalate-btn");
                    const resolveBtn =
                        document.getElementById("dyn-resolve-btn");

                    function syncDraft() {
                        appState.draft.title = titleEl.value;
                        appState.draft.priority = priorityEl.value;
                        appState.draft.summary = summaryEl.value;
                        if (appState.role === "senior") {
                            appState.draft.resolution = resolutionEl.value;
                        }
                        persist();
                    }

                    titleEl.addEventListener("input", syncDraft);
                    priorityEl.addEventListener("change", syncDraft);
                    summaryEl.addEventListener("input", syncDraft);
                    if (appState.role === "senior") {
                        resolutionEl.addEventListener("input", syncDraft);
                    }

                    saveBtn.addEventListener("click", () => {
                        const missing = [];
                        if (!titleEl.value.trim()) missing.push("Title");
                        if (!summaryEl.value.trim()) missing.push("Summary");

                        if (missing.length) {
                            errorEl.textContent =
                                "Cannot save. Please fill: " +
                                missing.join(", ");
                            errorEl.style.display = "block";
                            if (OS && OS.notify) {
                                OS.notify(
                                    "Dynamics: validation failed on save.",
                                );
                            }
                            return;
                        }

                        errorEl.style.display = "none";
                        syncDraft();

                        if (OS && OS.notify) {
                            OS.notify("Case saved in Dynamics (training).");
                        }
                        if (OS && OS.completeTask) {
                            OS.completeTask("dyn-save-case");
                        }
                    });

                    escalateBtn.addEventListener("click", () => {
                        appState.draft.status = "Escalated";
                        persist();
                        if (OS && OS.notify) {
                            OS.notify("Case escalated to Senior.");
                        }
                        if (OS && OS.completeTask) {
                            OS.completeTask("dyn-escalate-case");
                        }
                        render();
                    });

                    resolveBtn.addEventListener("click", () => {
                        if (appState.role !== "senior") {
                            errorEl.textContent =
                                "Only Senior Investigators can resolve cases.";
                            errorEl.style.display = "block";
                            if (OS && OS.notify) {
                                OS.notify(
                                    "Dynamics: Junior attempted to resolve a case.",
                                );
                            }
                            return;
                        }

                        if (!resolutionEl.value.trim()) {
                            errorEl.textContent =
                                "Resolution notes are required before resolving the case.";
                            errorEl.style.display = "block";
                            if (OS && OS.notify) {
                                OS.notify(
                                    "Dynamics: resolution notes missing.",
                                );
                            }
                            return;
                        }

                        errorEl.style.display = "none";
                        appState.draft.status = "Resolved";
                        syncDraft();

                        if (OS && OS.notify) {
                            OS.notify("Case resolved in Dynamics (training).");
                        }
                        if (OS && OS.completeTask) {
                            OS.completeTask("dyn-resolve-case");
                        }
                        render();
                    });
                }

                function escapeHtml(str) {
                    return String(str || "")
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;");
                }
            })();
        </script>
    </body>
</html>
