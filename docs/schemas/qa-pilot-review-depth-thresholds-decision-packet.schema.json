{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-pilot.carbideframe/schemas/qa-pilot-review-depth-thresholds-decision-packet-v1",
  "title": "QA Pilot Review Depth Thresholds Decision Packet",
  "description": "Schema for a bounded review packet connecting evidence-depth posture to Owner review. Does not auto-accept, auto-reject, approve, verify, execute, or seal. Owner is the only decision authority.",
  "type": "object",
  "required": [
    "packet_id", "source_threshold_id", "source_evidence_bundle_ref", "source_result_packet_ref",
    "source_consistency_guard_refs", "threshold_state", "packet_state", "review_summary", "created_at",
    "authority_disclaimer", "advisory_only", "custody", "librarian_impact"
  ],
  "properties": {
    "packet_id": { "type": "string", "pattern": "^DP-[A-Z0-9]+-[0-9]{4,6}$" },
    "source_threshold_id": { "type": "string", "pattern": "^TD-" },
    "source_evidence_bundle_ref": { "type": "string" },
    "source_result_packet_ref": { "type": "string" },
    "source_consistency_guard_refs": { "type": "array", "items": { "type": "string" } },
    "threshold_state": { "type": "string", "enum": ["sufficient","needs_more_context","blocked"] },
    "packet_state": { "type": "string", "enum": ["prepared","needs_owner_review","deferred","closed_by_owner"] },
    "review_summary": { "type": "string", "minLength": 3, "maxLength": 2000 },
    "created_at": { "type": "string", "format": "date-time" },
    "authority_disclaimer": {
      "type": "string",
      "const": "This decision packet connects evidence-depth posture to Owner review. It does not auto-accept evidence, auto-reject findings, approve intake, verify evidence, close workbench items, execute work, seal anything, or create autonomous authority. Owner is the only decision authority. Custody is qa-pilot-local. Librarian impact is none."
    },
    "custody": { "type": "string", "const": "qa-pilot-local" },
    "advisory_only": { "type": "boolean", "const": true },
    "librarian_impact": { "type": "string", "const": "none" }
  },
  "additionalProperties": false
}
