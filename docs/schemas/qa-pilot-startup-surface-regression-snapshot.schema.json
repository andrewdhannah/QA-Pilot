{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-pilot.carbideframe/schemas/qa-pilot-startup-surface-regression-snapshot-v1",
  "title": "QA Pilot Startup Surface Regression Snapshot",
  "description": "Expected-state snapshot for the integrated QA Pilot startup surface. Captures sealed head, registry count, RCR/RCG posture, and classifications for regression detection after future changes.",
  "type": "object",
  "required": [
    "snapshot_id", "title", "captured_at",
    "expected_sealed_head", "expected_sealed_number",
    "expected_registry_layer_count", "expected_latest_registry_layer",
    "expected_ph_12_status", "expected_dr_3_4_status",
    "expected_plr_status", "expected_sr_8_status",
    "expected_classification",
    "expected_rcr_receipts_found", "expected_rcr_latest_receipt",
    "expected_rcr_status", "expected_rcr_classification",
    "expected_rcg_latest_sealed", "expected_rcg_latest_rcr",
    "expected_rcg_coverage_gap", "expected_rcg_status",
    "expected_rcg_classification",
    "advisory_only", "custody", "librarian_impact"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "pattern": "^SRS-" },
    "title": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "expected_sealed_head": { "type": "string" },
    "expected_sealed_number": { "type": "integer", "minimum": 1 },
    "expected_registry_layer_count": { "type": "integer", "minimum": 0 },
    "expected_latest_registry_layer": { "type": "string" },
    "expected_ph_12_status": { "type": "string", "enum": ["pass", "fail", "degraded", "unchecked"] },
    "expected_dr_3_4_status": { "type": "string", "enum": ["pass", "fail", "degraded", "unchecked"] },
    "expected_plr_status": { "type": "string", "enum": ["pass", "fail", "degraded", "unchecked"] },
    "expected_sr_8_status": { "type": "string", "enum": ["pass", "fail", "degraded", "unchecked"] },
    "expected_classification": { "type": "string", "enum": ["ready", "degraded", "blocked", "unknown"] },
    "expected_rcr_receipts_found": { "type": "integer", "minimum": 0 },
    "expected_rcr_latest_receipt": { "type": "string" },
    "expected_rcr_status": { "type": "string", "enum": ["pass", "fail", "degraded", "no_receipts", "unchecked"] },
    "expected_rcr_classification": { "type": "string", "enum": ["ready", "degraded", "blocked", "unknown"] },
    "expected_rcg_latest_sealed": { "type": ["integer", "null"] },
    "expected_rcg_latest_rcr": { "type": ["integer", "null"] },
    "expected_rcg_coverage_gap": { "type": ["integer", "null"] },
    "expected_rcg_status": { "type": "string", "enum": ["pass", "fail", "degraded", "unknown", "no_rcr_receipts"] },
    "expected_rcg_classification": { "type": "string", "enum": ["ready", "degraded", "blocked", "unknown"] },
    "advisory_only": { "type": "boolean", "const": true },
    "custody": { "type": "string", "pattern": "^qa-pilot-local$" },
    "librarian_impact": { "type": "string", "const": "none" }
  }
}
