{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrewdhannah/QA-Pilot/schemas/qa-pilot-broker-mcp-advisory-surface.schema.json",
  "title": "QA Pilot Broker MCP Advisory Surface Response",
  "description": "Schema for a QA Pilot advisory surface response. Validates that the response contains all required advisory surface fields.",
  "type": "object",
  "required": [
    "surface",
    "command",
    "project_id",
    "authority",
    "accepted",
    "custody_verified",
    "audit_receipt_id",
    "broker_commit_or_version",
    "timestamp",
    "limitations"
  ],
  "properties": {
    "surface": {
      "type": "string",
      "const": "qa_pilot_broker_advisory_surface",
      "description": "Must identify this as a QA Pilot broker advisory surface response."
    },
    "command": {
      "type": "string",
      "enum": [
        "qa_pilot_broker_accept",
        "qa_pilot_broker_audit",
        "qa_pilot_broker_list_audit",
        "qa_pilot_broker_status",
        "qa_pilot_broker_enable",
        "qa_pilot_broker_disable"
      ],
      "description": "The advisory surface command that was executed."
    },
    "project_id": {
      "type": "string",
      "const": "qa-pilot",
      "description": "Must be qa-pilot."
    },
    "authority": {
      "type": "string",
      "const": "advisory_only",
      "description": "All surface responses are advisory-only."
    },
    "accepted": {
      "type": "boolean",
      "description": "Whether the command was accepted."
    },
    "custody_verified": {
      "type": "boolean",
      "description": "Whether custody checks passed."
    },
    "refusal_code": {
      "type": "string",
      "description": "Refusal code when rejected."
    },
    "audit_receipt_id": {
      "type": "string",
      "description": "Broker audit receipt ID for this command."
    },
    "broker_commit_or_version": {
      "type": "string",
      "enum": ["qap-broker-v1"],
      "description": "Broker version identifier."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
      "description": "ISO 8601 timestamp."
    },
    "limitations": {
      "type": "string",
      "minLength": 1,
      "description": "Advisory limitation notice."
    },
    "output": {
      "type": "object",
      "description": "Optional output data from the underlying broker command."
    },
    "error": {
      "type": "string",
      "description": "Error detail if rejected."
    }
  }
}
