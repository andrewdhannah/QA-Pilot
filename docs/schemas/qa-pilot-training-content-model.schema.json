{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "active/qa-pilot/docs/schemas/qa-pilot-training-content-model.schema.json",
  "title": "QA Pilot Training Content Model",
  "description": "Unified schema for 7 training artifact types. Extends V2 course-pack-v1 with governance, provenance, and source lineage fields. Every artifact must declare audience, validation status, ownership state, and source references.",
  "type": "object",
  "required": [
    "schema_version", "pack_id", "title", "artifact_type", "intended_audience",
    "generated_at", "content", "provenance", "governance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "training-content-v1" },
    "pack_id": { "type": "string", "pattern": "^TC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "artifact_type": {
      "type": "string",
      "enum": [
        "onboarding_guide",
        "operator_guide",
        "developer_guide",
        "troubleshooting_guide",
        "architecture_explanation",
        "workflow_tutorial",
        "validation_exercise"
      ],
      "description": "Type of training artifact"
    },
    "intended_audience": {
      "type": "string",
      "enum": ["onboarding", "operator", "developer", "architect", "all"],
      "description": "Target audience for this artifact"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TC-[A-Z0-9-]+$" },
      "description": "Prerequisite pack IDs"
    },
    "content": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "body", "sources"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 },
              "content_type": {
                "type": "string",
                "enum": ["text", "code", "exercise", "quiz", "reference", "diagram"]
              },
              "sources": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "description": "Librarian source document paths. Must have at least 1 source reference."
              },
              "exercises": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prompt": { "type": "string" },
                    "expected_outcome": { "type": "string" }
                  }
                },
                "description": "Optional exercises for validation_exercise and workflow_tutorial types"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["librarian_sources", "generator", "generator_version", "source_hash"],
      "properties": {
        "librarian_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "revision"],
            "properties": {
              "path": { "type": "string" },
              "revision": { "type": "string" },
              "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "minItems": 1
        },
        "generator": { "type": "string" },
        "generator_version": { "type": "string" },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "governance": {
      "type": "object",
      "required": ["authority_posture", "owner_decision_required_for_publish", "validation_status", "source_coverage_pct"],
      "properties": {
        "authority_posture": { "type": "string", "const": "advisory" },
        "owner_decision_required_for_publish": { "type": "boolean", "const": true },
        "validation_status": {
          "type": "string",
          "enum": ["draft", "validated", "failed", "owner_approved"]
        },
        "source_coverage_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ownership_state": {
          "type": "string",
          "enum": ["unowned", "owned_by_project", "owned_by_librarian", "shared"],
          "description": "Who owns maintaining this artifact"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact_type": { "const": "validation_exercise" } } },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "sections": {
                "items": {
                  "required": ["exercises"],
                  "properties": {
                    "exercises": { "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "artifact_type": { "const": "workflow_tutorial" } } },
      "then": {
        "properties": {
          "content": {
            "properties": {
              "sections": {
                "items": {
                  "required": ["exercises"],
                  "properties": {
                    "exercises": { "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
